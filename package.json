{
  "name": "ged-eye",
  "version": "0.1.0",
  "description": "Modern family tree viewer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "upload-media": "node --env-file=.env.local scripts/neon/uploadMedia.js",
    "db:migrate": "node --env-file=.env.local scripts/neon/migrate.js",
    "import-ged": "node --env-file=.env.local scripts/neon/importGed.js",
    "verify-neon": "node --env-file=.env.local scripts/neon/verify.js",
    "backfill-facts": "node --env-file=.env.local scripts/neon/backfillFacts.js",
    "test:db": "node --env-file=.env.local --env-file=.env.test.local node_modules/vitest/vitest.mjs run tests/db --no-file-parallelism"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "jsdom": "^25.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@canvas/image": "^1.0.0",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@neon/functions": "^0.11.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/face-api": "^1.7.0",
    "canvas": "^2.11.2",
    "cytoscape": "^3.30.0",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5",
    "parse-gedcom": "^2.0.0",
    "pg": "^8.23.1",
    "sharp": "^0.33.0"
  }
}
